VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (used by api/* serverless functions — never read by the
# Vite frontend bundle). Set these in Vercel's Project Settings too, since
# Vercel never reads this local .env file in production.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
STRIPE_PRICE_STANDARD=price_your-standard-price-id
STRIPE_PRICE_PREMIUM=price_your-premium-price-id
